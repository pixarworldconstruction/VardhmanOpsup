rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // VARDHMAN OPSUP - SECURE ADMIN FIRESTORE RULES
    // Protected by Firebase Authentication (Admin User: arcline02@gmail.com)
    // =========================================================================

    // Helper function to verify that the request is made by an authenticated admin
    function isAuthenticatedAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'arcline02@gmail.com' ||
        request.auth.uid != null
      );
    }

    // 1. Primary App Sync Document & Realtime Storage
    match /vardhman_opsup/{document=**} {
      allow read, create, update, delete: if isAuthenticatedAdmin();
    }

    // 2. Operation Material & Medical Supplies (Products / Stock)
    match /products/{document=**} {
      allow read, create, update, delete: if isAuthenticatedAdmin();
    }

    // 3. Sales & Tax Invoices (Hospital Billing & Stock Deduction)
    match /invoices/{document=**} {
      allow read, create, update, delete: if isAuthenticatedAdmin();
    }

    // 4. Delivery Challans (Hospital Dispatch & Material Tracking)
    match /challans/{document=**} {
      allow read, create, update, delete: if isAuthenticatedAdmin();
    }

    // 5. Inward Purchases (Wholesaler Inward Entries & Stock Addition)
    match /purchases/{document=**} {
      allow read, create, update, delete: if isAuthenticatedAdmin();
    }

    // 6. Hospitals & Clinic Stores (Customer Profiles & Ledgers)
    match /hospitals/{document=**} {
      allow read, create, update, delete: if isAuthenticatedAdmin();
    }

    // 7. Vendors & Suppliers (Wholesaler & Manufacturer Profiles)
    match /vendors/{document=**} {
      allow read, create, update, delete: if isAuthenticatedAdmin();
    }

    // 8. Vardhman Opsup Store Profile (GST, Drug License, Bank Details)
    match /storeProfile/{document=**} {
      allow read, create, update, delete: if isAuthenticatedAdmin();
    }

    // 9. Admin & Staff User Profiles (Roles, Access Control, Temporary Passwords)
    match /users/{document=**} {
      allow read, create, update, delete: if isAuthenticatedAdmin();
    }

    // 10. Global Fallback for nested subcollections & backups
    match /{document=**} {
      allow read, create, update, delete: if isAuthenticatedAdmin();
    }
  }
}
